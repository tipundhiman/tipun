/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000

# This is the only page that needs a microphone. Keep all other pages blocked.
/vocal-lab*
  ! Permissions-Policy

/vocal-lab*
  Permissions-Policy: camera=(), microphone=(self), geolocation=()

/sing-your-song*
  ! Permissions-Policy

/sing-your-song*
  Permissions-Policy: camera=(), microphone=(self), geolocation=()

# Creator Lab's private voice memo is the only section needing microphone permission.
# Microphone is prompted by the browser and recordings are not sent to our API.
/creator-lab*
  Permissions-Policy: camera=(), microphone=(self), geolocation=()

# Prevent Kids Studio from making network API calls or loading third-party frames.
# It stores only a nickname and writing drafts on the current device.
/kids.html
  Cache-Control: no-store
  Referrer-Policy: no-referrer
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'none'; img-src 'self' data:; font-src 'self' data:; frame-src 'none'; form-action 'none'; object-src 'none'; base-uri 'self'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

/age-check.html
  Cache-Control: no-store
  Referrer-Policy: no-referrer
